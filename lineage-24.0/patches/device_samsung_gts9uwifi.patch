diff --git a/Android.bp b/Android.bp
index 167e8cb4105eaeaf06ffb3c871b5b40fb77bdd87..750c8548f83882cc359e46a43810d640158cc6a9 100644
--- a/Android.bp
+++ b/Android.bp
@@ -6,6 +6,13 @@
 soong_namespace {
 }
 
+install_symlink {
+    name: "spen_firmware_early_symlink",
+    vendor: true,
+    installed_location: "firmware/early/wez01_gts9u.bin",
+    symlink_target: "/vendor/firmware/wez01_gts9u.bin",
+}
+
 install_symlink {
     name: "firmware_wlanmdsp.otaupdate_symlink",
     vendor: true,
@@ -40,3 +47,10 @@ install_symlink {
     installed_location: "firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini",
     symlink_target: "/vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini",
 }
+
+// Share the device partition layout with the common vendor fstab module.
+filegroup {
+    name: "fstab.gts9uwifi.source",
+    srcs: ["init/fstab.qcom"],
+    visibility: ["//visibility:public"],
+}
diff --git a/BoardConfig.mk b/BoardConfig.mk
index 0d7d10008b0c207ba5871551abd55bc24957110f..195755aa39c4fc6fb30b2ec2f728bb1bef0004f3 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -12,6 +12,9 @@ TARGET_IS_TABLET := true
 
 DEVICE_PATH := device/samsung/gts9uwifi
 
+# Use the same partition layout in recovery and normal boot.
+TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/init/fstab.qcom
+
 # Assert
 TARGET_OTA_ASSERT_DEVICE := gts9uwifi,gts9u
 
@@ -20,6 +23,12 @@ TARGET_SCREEN_DENSITY := 350
 
 # Kernel
 TARGET_KERNEL_CONFIG := gts9uwifi_defconfig
+# Limit nested kernel builds alongside Android compilation.
+TARGET_KERNEL_ADDITIONAL_FLAGS += -j8
+
+# Let the kernel read the S Pen firmware during I2C probe.
+BOARD_KERNEL_CMDLINE := $(filter-out firmware_class.path=%,$(BOARD_KERNEL_CMDLINE))
+BOARD_KERNEL_CMDLINE += firmware_class.path=/vendor/firmware_mnt/image,/vendor/firmware/early
 
 # Kernel Modules
 BOARD_RECOVERY_RAMDISK_KERNEL_MODULES_LOAD := $(strip $(shell cat $(DEVICE_PATH)/modules.load.recovery))
@@ -67,5 +76,6 @@ TARGET_USES_SAMSUNG_FINGERPRINT := true
 
 BOARD_RECOVERYIMAGE_PARTITION_SIZE := 104857600
 
-# SEPolicy (for bootanimation rotation)
+# SEPolicy
 PRODUCT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/private
+BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
