diff --git a/sepolicy/vendor/hal_face_default.te b/sepolicy/vendor/hal_face_default.te
new file mode 100644
index 0000000000000000000000000000000000000000..f9712ed6b6ea19655f1155f95f0e999e690be609
--- /dev/null
+++ b/sepolicy/vendor/hal_face_default.te
@@ -0,0 +1,15 @@
+# Open the front camera through the vendor NDK camera client.
+allow hal_face_default fwk_camera_service:service_manager find;
+binder_call(hal_face_default, cameraserver)
+binder_call(cameraserver, hal_face_default)
+hal_client_domain(hal_face_default, hal_graphics_allocator)
+
+# Samsung's preview buffer-queue adapter uses the HIDL token manager.
+hwbinder_use(hal_face_default)
+allow hal_face_default hidl_token_hwservice:hwservice_manager find;
+
+# The CYG1 face engine uses the sec_fr trusted app from the firmware partition.
+r_dir_file(hal_face_default, firmware_file)
+allow hal_face_default tee_device:chr_file rw_file_perms;
+allow hal_face_default vendor_dmabuf_qseecom_heap_device:chr_file rw_file_perms;
+allow hal_face_default vendor_dmabuf_qseecom_ta_heap_device:chr_file rw_file_perms;
diff --git a/sepolicy/vendor/vendor_time_client.te b/sepolicy/vendor/vendor_time_client.te
new file mode 100644
index 0000000000000000000000000000000000000000..abe4c84551727465d86f9672589d087a9956456f
--- /dev/null
+++ b/sepolicy/vendor/vendor_time_client.te
@@ -0,0 +1,13 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# One-shot shutdown helper; it only submits the current clock to time_daemon.
+type vendor_time_client, domain;
+type vendor_time_client_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(vendor_time_client)
+
+allow vendor_time_client self:unix_stream_socket create_stream_socket_perms;
+allow vendor_time_client vendor_time_daemon:unix_stream_socket connectto;
+
+# time_daemon authenticates the client using /proc/<pid>/comm.
+allow vendor_time_daemon vendor_time_client:dir search;
+allow vendor_time_daemon vendor_time_client:file { open read };
