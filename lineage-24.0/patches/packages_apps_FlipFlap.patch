diff --git a/src/org/lineageos/flipflap/FlipFlapUtils.java b/src/org/lineageos/flipflap/FlipFlapUtils.java
index 03bd9c67e7f07c4f11cce1cfa2920cb8a51f2d35..b599c7c809c6d766642961aa6d3cd5d5d05877da 100644
--- a/src/org/lineageos/flipflap/FlipFlapUtils.java
+++ b/src/org/lineageos/flipflap/FlipFlapUtils.java
@@ -21,6 +21,10 @@
 package org.lineageos.flipflap;
 
 import android.content.Context;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.provider.Settings;
 import android.content.SharedPreferences;
 import android.preference.PreferenceManager;
 
@@ -60,6 +64,21 @@ public class FlipFlapUtils {
             COVER_STYLE_RECTANGULAR
     };
 
+    public static boolean isCoverEnabled(Context context) {
+        final ComponentName receiver = new ComponentName(context, EventReceiver.class);
+        return context.getPackageManager().getComponentEnabledSetting(receiver)
+                != PackageManager.COMPONENT_ENABLED_STATE_DISABLED;
+    }
+
+    public static void syncCoverEnabledState(Context context) {
+        final boolean enabled = isCoverEnabled(context);
+        Settings.Global.putInt(context.getContentResolver(),
+                Settings.Global.LID_SWITCH_ENABLED, enabled ? 1 : 0);
+        if (!enabled) {
+            context.stopService(new Intent(context, FlipFlapService.class));
+        }
+    }
+
     public static int getCoverStyle(Context context) {
         return context.getResources().getInteger(R.integer.config_deviceCoverType);
     }
